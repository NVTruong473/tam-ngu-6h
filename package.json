{
  "name": "tam-ngu-6h-pwa",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "dev:static": "SITES_STATIC_PREVIEW=1 vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:github": "GITHUB_PAGES=1 SITES_STATIC_PREVIEW=1 vinext build",
    "build:native": "GITHUB_PAGES=1 SITES_STATIC_PREVIEW=1 vinext build && npx cap sync",
    "native:ios": "npm run build:native && npx cap open ios",
    "native:android": "npm run build:native && npx cap open android",
    "generate:curriculum": "node scripts/generate-curriculum.mjs",
    "append:curriculum": "node scripts/append-curriculum.mjs",
    "enrich:pronunciation": "node scripts/enrich-vietnamese-readings.mjs",
    "repair:pronunciation": "node scripts/repair-vietnamese-readings.mjs",
    "generate:notification-snippets": "node scripts/generate-notification-snippets.mjs",
    "verify:curriculum": "node scripts/verify-curriculum.mjs",
    "supabase:apply": "node scripts/apply-supabase-migration.mjs",
    "supabase:lookup-secrets": "node scripts/configure-supabase-lookup.mjs",
    "api-keys:audit": "node scripts/audit-api-key-file.mjs",
    "supabase:deploy": "node scripts/deploy-supabase-function.mjs",
    "supabase:verify": "node scripts/verify-supabase-api.mjs",
    "supabase:cron:audit": "node scripts/audit-supabase-cron.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run verify:curriculum && npm run build:github && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/push-notifications": "^8.1.3",
    "drizzle-orm": "0.45.2",
    "next": "^16.4.3",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "pinyin": "4.0.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
